# Supabase — get these from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — Project Settings > API > service_role. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — get these from Settings > API Keys in your Razorpay dashboard
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose in the browser.
# RAZORPAY_KEY_SECRET must stay server-side only. Never commit this file with real values.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
